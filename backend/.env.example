# Private key of the relayer account that owns MockUSDC and FairStream. Keep it secret.
RELAYER_PRIVATE_KEY=

# Monad testnet RPC URL. Optional: defaults to the RPC in deployments.json.
MONAD_RPC=

# Port to listen on. Render sets this itself; locally it defaults to 4000.
PORT=

# Deployed frontend URL(s) allowed by CORS, comma-separated, e.g. your Vercel URL.
# http://localhost:3000 is always allowed.
FRONTEND_URL=

# Optional: path to deployments.json if it isn't at backend/deployments.json.
DEPLOYMENTS_PATH=

# Only for npm run simulate: backend URL to test against. Defaults to http://localhost:$PORT.
API_URL=
