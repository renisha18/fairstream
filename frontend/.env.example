# Backend base URL, e.g. your Render service URL. Defaults to http://localhost:4000.
NEXT_PUBLIC_BACKEND_URL=

# Envio indexer GraphQL endpoint. Optional: /account falls back to the backend if unset.
NEXT_PUBLIC_ENVIO_URL=

# Passkey domain. Leave unset for localhost; set to the production domain when deploying
# and never change it afterwards (accounts are tied to it).
NEXT_PUBLIC_RP_ID=
